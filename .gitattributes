# Preserve the exact bytes of this newly ingested raw source.
"硬件/原始备份/射频PCB设计知识全集-三套课程合并笔记.md" -text -whitespace

# PDFs are binary; override global diff=astextplain and newline conversion.
*.pdf binary
*.PDF binary

# Immutable source archives must retain their original bytes and whitespace.
"硬件/原始备份/**" -text -whitespace

# Keep curated-source checksums portable across Windows/Linux checkouts.
"硬件/原理/**" text eol=lf
"硬件/PCB/**" text eol=lf
/.githooks/* text eol=lf
/scripts/*.py text eol=lf
# Hash-bound public evidence must have identical bytes in worktrees and Git.
/journal/health-check-*.md text eol=lf
/audit/*.md text eol=lf
/audit/*.csv text eol=lf
/audit/*.json text eol=lf
# EDA project archives and compressed assets are binary.
*.epro2 binary
*.zip binary
