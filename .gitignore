# ===== Obsidian 本地状态（每次开关都会变，不需要版本控制）=====
.obsidian/workspace.json
.obsidian/workspace_backup.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/cache
.obsidian/.trash/

# 插件写入的运行时状态
.obsidian/plugins/*/last_loaded.txt
.obsidian/plugins/*/cache/
.obsidian/plugins/*/*.log

# ===== 插件二进制（体积大、随插件更新频繁变更）=====
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json

# ===== 系统与编辑器临时文件 =====
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*~

# ===== 大附件可选排除（如需同步图片，请注释掉下面两行）=====
# *.pdf
# *.zip

# ===== Git 自身的临时文件 =====
*.orig
*.rej

# 用户私人资料：仅保留本机，禁止提交及公开派生内容
/硬件/私人备份/
/.kb.local.json

# 私人工作日志、规划库及维护时间线：仅本地保存
/journal/daily/
/journal/planning/
/log.md
/工作日志/
/规划库/
/.planning/

# Python检查脚本运行缓存
__pycache__/
*.py[cod]

# 本地工程连接器、视觉路由和工具运行目录
/.dsh-vision-router/
/.easyeda/
/.tools/
# 第三方插件运行配置与凭据辅助脚本（仅本地保存，避免误提交 API Key 或本机路径）
.obsidian/plugins/*/data.json
.obsidian/plugins/*/obsidian_askpass.sh

# 整理工作区临时中间产物（非正式知识库来源）
/硬件/_整理工作区/
